# ------------------------------------------------------------
# DUNGEON ADVENTURES CONTENT RULES (kept from Dev)
# ------------------------------------------------------------

# Ignore stray JSON, but keep the shipped game content
*.json
!/Data/**/*.json
!/GameData/**/*.json
!/Src/DevTools/*.json

# Generated / sensitive files
*.dat
*.xml
*.iss
*.log
DungeonAdventures.Tests.csproj
UnitTest1.cs

