<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>

		<Version>1.0.0</Version>
		<IsPackable>true</IsPackable>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>dungeon</ToolCommandName>
		<PackageId>Dungeon-Adventures</PackageId>
		<AssemblyName>Dungeon-Adventures</AssemblyName>
		<RootNamespace>DungeonAdventures</RootNamespace>
		<TieredCompilation>true</TieredCompilation>

		<Authors>Kgbcupcake</Authors>
		<Description>Dungeon Adventures - Reborn: a terminal fantasy dungeon crawler. Search for the one you lost, starting from the village of Ashford, clear the floors beneath Hollowmere and face the Dread King.</Description>
		<PackageReleaseNotes>
			[Dungeon Adventures - Reborn]
			- Fantasy re-theme: classes, monsters, bosses and dungeon floors.
			- Story text loaded from data (GameData/Templates/story).
		</PackageReleaseNotes>
		<PackageTags>Game;CLI;RPG;Fantasy;DungeonCrawler;Roguelike</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<None Include="GameData\Templates\**\*.json;GameData\Data\Dungeons\**\*.json;Data\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!-- Item icons (16x16 PNG, named after the item). Licensed art, kept out of git: see assets/icons/README.md -->
		<None Include="assets\icons\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!-- Raven clothing icons (32x32) for the creator's CLOTHES tab: see Src/Dev/copy-clothing.sh -->
		<None Include="assets\icons\clothing\**\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<Content Include="GameData\Templates\monsters\*.json;GameData\Templates\floors\*.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Remove="**/*:Zone.Identifier" />
		<Compile Remove="**/*:Zone.Identifier" />

		<Compile Remove="src\dev\.seeded\**;Src\GameData\Data\**;Src\GameData\gems\**;Src\GameData\items\**;Src\GameData\weapons\**;Src\Maries_Ui\**;Src\Maries_DataModels\**;Src\Maries_Loaders\**" />
		<None Remove="src\dev\.seeded\**;Src\GameData\Data\**;Src\GameData\gems\**;Src\GameData\items\**;Src\GameData\weapons\**;Src\Maries_Ui\**;Src\Maries_DataModels\**;Src\Maries_Loaders\**" />
		<Compile Remove="Src\Interfaces\DevGui_Main.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="Src\Maries_Ui\Maries_Ui.csproj" />
		<ProjectReference Include="Src\Maries_DataModels\Maries_DataModels.csproj" />
		<ProjectReference Include="Src\Maries_Loaders\Maries_Loaders.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.1.1" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
		<PackageReference Include="NUnit" Version="3.13.3" />
		<PackageReference Include="NUnit3TestAdapter" Version="4.2.1" />
		<PackageReference Include="NUnit.Analyzers" Version="3.6.1" />
		<PackageReference Include="coverlet.collector" Version="6.0.0" />
		<PackageReference Include="Ollama" Version="1.15.0" />
		<PackageReference Include="OllamaSharp" Version="5.4.12" />
		<PackageReference Include="OpenAI" Version="2.8.0" />
		<PackageReference Include="Pastel" Version="7.0.1" />
		<PackageReference Include="Spectre.Console" Version="0.54.0" />
		<PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
		<PackageReference Include="Spectre.Console.Json" Version="0.54.0" />
	</ItemGroup>

	<Target Name="SpookyCleanup" BeforeTargets="Clean">
		<Message Text="🧹 Cleaning bin/ and obj/..." Importance="high" />
		<Exec Condition="'$(OS)' == 'Windows_NT'" Command="rd /s /q &quot;$(ProjectDir)obj&quot; 2&gt;nul &amp; rd /s /q &quot;$(ProjectDir)bin&quot; 2&gt;nul" ContinueOnError="true" />
		<Exec Condition="'$(OS)' != 'Windows_NT'" Command="rm -rf &quot;$(ProjectDir)obj&quot; &quot;$(ProjectDir)bin&quot; 2&gt;/dev/null" ContinueOnError="true" />
	</Target>

</Project>